{
  "name": "battleships",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/contracts",
    "packages/game-engine"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "npm run build --workspace @battleships/contracts && npm run build --workspace @battleships/game-engine && npm run build --workspace @battleships/server && npm run build --workspace @battleships/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
